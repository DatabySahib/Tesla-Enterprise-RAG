# Tesla Enterprise RAG -- environment configuration
# Copy to `.env` and edit. Every value below is optional; the defaults shown
# are what the pipeline uses when the variable is absent.
#
#   cp .env.example .env

# --- Paths ----------------------------------------------------------------
# Relative paths resolve against the project root, not your shell's cwd.
DATA_DIR=data
PDF_FILENAME=TSLA-Q4-2025-Update.pdf
CHROMA_DIR=chroma_db

# --- Chunking -------------------------------------------------------------
# Blueprint specification: 800 / 150. Overlap must be < chunk size.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Embeddings (local, no API key required) ------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps
NORMALIZE_EMBEDDINGS=true
EMBEDDING_BATCH_SIZE=32

# --- Vector store ---------------------------------------------------------
COLLECTION_NAME=tesla_q4_2025
DISTANCE_METRIC=cosine        # cosine | l2 | ip

# --- Retrieval ------------------------------------------------------------
RETRIEVER_K=5
SEARCH_TYPE=mmr               # mmr (diversified) | similarity (plain top-k)
MMR_FETCH_K=20                # candidates MMR re-ranks down to RETRIEVER_K
MMR_LAMBDA=0.7                # 1.0 = pure relevance, 0.0 = pure diversity

# --- LLM backend ----------------------------------------------------------
# auto        -> try openai, then ollama, then fall back to extractive
# openai      -> requires OPENAI_API_KEY and `pip install langchain-openai`
# ollama      -> requires a local Ollama daemon and `pip install langchain-ollama`
# huggingface -> local seq2seq model, no API key. Opt-in only: NOT part of `auto`,
#                because selecting it downloads ~1 GB on first use.
# extractive  -> no generation at all; returns ranked source passages
LLM_BACKEND=auto
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=768

# OpenAI (only read when the openai backend is selected)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Local HuggingFace generation
HF_MODEL=google/flan-t5-base

# --- FastAPI service ------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
